# Static hosting config for the Vite build (Apache / LiteSpeed).
# Lives in public/, so Vite copies it into dist/ on every build.

# Correct MIME types. Getting this wrong is what breaks module scripts:
# a .js served as application/octet-stream is rejected by the browser.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css            .css
  AddType image/svg+xml       .svg
  AddType application/json    .json
  AddType font/woff2          .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints asset filenames, so a given URL's contents never
  # change -- safe to cache hard and skip revalidation entirely.
  <FilesMatch "\.(js|mjs|css|woff2|png|jpg|jpeg|webp|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html points at the current hashed bundles, so it must always be
  # revalidated -- otherwise visitors keep requesting a bundle that is gone.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Single-page app fallback: anything that is not a real file or directory
  # renders index.html, so deep links and refreshes do not 404. Real assets
  # still resolve normally because of the !-f / !-d guards.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Don't hand out directory listings for folders without an index.
Options -Indexes
